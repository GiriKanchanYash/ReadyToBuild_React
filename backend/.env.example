SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=CORTEX_ANALYST_WH
SNOWFLAKE_DATABASE=CLEAR_TO_BUILD_DEV
SNOWFLAKE_SCHEMA=INFORMATION_MART
SNOWFLAKE_ROLE=your_role

# Microsoft Fabric
# Use the SQL endpoint hostname shown for the Fabric Warehouse/Lakehouse.
FABRIC_SQL_SERVER=your_fabric_sql_endpoint
FABRIC_READYTOBUILD_DATABASE=ReadyToBuild
FABRIC_READYTOBUILD_WAREHOUSE_DATABASE=ReadyToBuild
FABRIC_AUTH_MODE=interactive

# Entra ID (used for Fabric/Key Vault where configured)
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Optional Azure OpenAI for Fabric Copilot
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-08-01-preview
